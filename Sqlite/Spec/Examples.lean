import Sqlite.Spec.Defs

/-!
  The inputs of `Sqlite.Spec.examples` and `Sqlite.Spec.rejects`.
-/

namespace Sqlite.Spec

/-- The first 100 bytes of a database that SQLite 3.45.1 wrote: 512-byte
    pages, one table of six rows, three pages in all. -/
def sqliteHeaderBytes : List UInt8 :=
  [0x53, 0x51, 0x4C, 0x69, 0x74, 0x65, 0x20, 0x66, 0x6F, 0x72, 0x6D, 0x61, 0x74, 0x20, 0x33, 0x00,
   0x02, 0x00, 0x01, 0x01, 0x00, 0x40, 0x20, 0x20, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x03,
   0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x04,
   0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00,
   0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
   0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02,
   0x00, 0x2E, 0x76, 0x89]

/-- That header's fields: change counter 2, three pages, schema cookie 1,
    schema format 4, UTF-8, valid for change 2, written by SQLite
    3045001. -/
def sqliteHeader : Header :=
  { pageSize := 512, writeVersion := 1, readVersion := 1, reserved := 0, changeCounter := 2,
    databaseSize := 3, freelistTrunk := 0, freelistCount := 0, schemaCookie := 1,
    schemaFormat := 4, cacheSize := 0, largestRoot := 0, textEncoding := 1, userVersion := 0,
    incrementalVacuum := 0, applicationId := 0, versionValidFor := 2, sqliteVersion := 3045001 }

/-- A one-page file, written by hand: that header, then on page 1 a
    table leaf page with one cell at offset 507, the last five bytes of
    the page. The cell has a payload of 3 bytes, rowid 1, and the payload
    02 01 05: a record of one 8-bit integer, 5. -/
def onePageFile : List UInt8 :=
  sqliteHeaderBytes ++ [0x0D, 0x00, 0x00, 0x00, 0x01, 0x01, 0xFB, 0x00] ++ [0x01, 0xFB] ++
    List.replicate 397 0 ++ [0x03, 0x01, 0x02, 0x01, 0x05]

end Sqlite.Spec
